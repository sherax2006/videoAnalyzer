# Ignore virtual environment
venv/
.venv/
.env
.env.*  # Any environment-specific config
.envrc

# Python cache files
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Python build artifacts
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/
*.egg

# Test & typing caches
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter Notebook checkpoint files
.ipynb_checkpoints/

# macOS and system files
.DS_Store
Thumbs.db

# Spleeter output (optional – unless you want to track results)
spleeter_output/
# If you keep example WAVs in repo, avoid globally ignoring them.
# To ignore generated WAVs under Spleeter outputs only, you could use:
# spleeter_output/**/*.wav

# Streamlit config/cache
.streamlit/
# If you want to keep a committed config, uncomment:
# !.streamlit/config.toml

# Temporary files
*.log
*.tmp
*.temp
*~
*.bak
*.swp
*.old

# VSCode and IDE settings (optional)
.vscode/
.idea/
*.code-workspace

# Streamlit cloud cache (optional)
.cache/
